DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Keep sqlite for the first local run. Change to mysql after MySQL setup.
DB_ENGINE=sqlite
DB_NAME=myntra_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Email defaults to console output during local testing.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_gmail_address
EMAIL_HOST_PASSWORD=your_16_character_gmail_app_password
DEFAULT_FROM_EMAIL=your_gmail_address
